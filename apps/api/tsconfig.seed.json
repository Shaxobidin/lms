{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noEmit": true,
    "isolatedModules": false
  },
  "ts-node": {
    "transpileOnly": true,
    "files": true,
    "compilerOptions": {
      "module": "CommonJS",
      "moduleResolution": "Node"
    },
    "require": ["tsconfig-paths/register"]
  },
  "include": ["prisma/**/*.ts", "src/**/*.ts", "../../packages/shared/src/**/*.ts"]
}
